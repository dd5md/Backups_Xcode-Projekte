/// Wie SmartSDR „Disp“: Spektrum (AVG, FPS, Füllung, Weighted Average, dB-Bereich)
/// und Wasserfall (Color Gain, Black Level, Auto Black, Tempo)
struct DisplayPopup: View {
  private let radio = RadioVerbindung.shared
  /// Füllung unter der Spektrum-Linie: 0 = aus, 1 = an (weiß), 2 = Farbe – nur in xSDR64
  @AppStorage("spektrumFuellung") private var fuellung = 1
  @AppStorage("spektrumFuellStaerke") private var fuellStaerke = 35.0
  @State private var hintergrund = Hintergrundbild.shared
  @AppStorage(MausHinweis.anKey) private var mausHinweisAn = true
  @AppStorage(MarkenEinstellung.anKey) private var memoriesAn = true
  @AppStorage(MarkenEinstellung.groesseKey) private var memoriesSchrift = 11.0
  @AppStorage(MarkenEinstellung.hoeheKey) private var memoriesHoehe = 15.0
  @AppStorage(Filterflaeche.staerkeKey) private var filterStaerke = 10.0
  @AppStorage(Filterflaeche.farbeKey) private var filterFarbe = "FFFFFF"

  var body: some View {
    let s = radio.meinSlice
    let pan = s.flatMap { sl in radio.api.panadapters.first { $0.id == sl.panadapterId } }
    let wf = pan.flatMap { p in radio.api.waterfalls.first { $0.panadapterId == p.id } }
    VStack(alignment: .leading, spacing: 0) {
     VStack(alignment: .leading, spacing: 0) {
      Text("SPEKTRUM").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
        .frame(height: Mass.zeilenHoehe)
      regler("AVG", panZahl(pan, \.average, "average"))
      regler("FPS", panZahl(pan, \.fps, "fps"), bereich: 1...30)
      HStack(spacing: Abstand.s) {
        Text("Füllung").frame(width: 96, alignment: .leading)
        RimuPicker(selection: $fuellung, options: [0, 1, 2]) { ["Aus", "An", "Farbe"][$0] }
      }
      .frame(height: Mass.zeilenHoehe)
      regler("Stärke", $fuellStaerke)
      HStack {
        Text("Weighted Average")
        Spacer()
        Toggle("", isOn: panSchalter(pan, \.weightedAverageEnabled, "weighted_average"))
          .toggleStyle(.checkbox).labelsHidden()
      }
      .frame(height: Mass.zeilenHoehe)
      regler("dB min", dbm(pan, unten: true), bereich: -160...(-60))
      regler("dB max", dbm(pan, unten: false), bereich: -100...0)

      Furche().padding(.vertical, Abstand.s)

      Text("WASSERFALL").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
        .frame(height: Mass.zeilenHoehe)
      regler("Color Gain", wfZahl(wf, \.colorGain, "color_gain"))
      regler("Black Level", wfZahl(wf, \.blackLevel, "black_level"))
      HStack {
        Text("Auto Black Level")
        Spacer()
        Toggle("", isOn: wfSchalter(wf, \.autoBlackEnabled, "auto_black"))
          .toggleStyle(.checkbox).labelsHidden()
      }
      .frame(height: Mass.zeilenHoehe)
      // Rate wie SmartSDR: der Wert geht 1:1 ans Radio (line_duration) – höher = schneller
      regler("Rate", wfZahl(wf, \.lineDuration, "line_duration"), bereich: 60...100)  // darunter steht er praktisch
     }
     .disabled(pan == nil)

      Furche().padding(.vertical, Abstand.s)

      HStack {
        Text("Frequenz an der Maus")
        Spacer()
        Toggle("", isOn: $mausHinweisAn).toggleStyle(.checkbox).labelsHidden()
      }
      .frame(height: Mass.zeilenHoehe)

      Furche().padding(.vertical, Abstand.s)

      // Speicherplätze im Spektrum
      HStack {
        Text("MEMORIES").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
        Spacer()
        Toggle("", isOn: $memoriesAn).toggleStyle(.checkbox).labelsHidden()
      }
      .frame(height: Mass.zeilenHoehe)
      regler("Schrift", $memoriesSchrift, bereich: 8...18)
        .disabled(!memoriesAn)
      regler("Höhe", $memoriesHoehe, bereich: 3...90)
        .disabled(!memoriesAn)

      Furche().padding(.vertical, Abstand.s)

      // Helle Fläche des Filters (Durchlassbereich) – Stärke und Farbe
      Text("FILTERFLÄCHE").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
        .frame(height: Mass.zeilenHoehe)
      regler("Stärke", $filterStaerke, bereich: 0...40)
      HStack(spacing: Abstand.s) {
        Text("Farbe").frame(width: 96, alignment: .leading)
        ColorPicker("", selection: Binding(get: { Filterflaeche.farbe(filterFarbe) },
                                           set: { filterFarbe = Filterflaeche.hex($0) }),
                    supportsOpacity: false)
          .labelsHidden()
        Spacer()
        Button("Standard") { filterFarbe = "FFFFFF"; filterStaerke = 10 }.buttonStyle(KnopfStil())
      }
      .frame(height: Mass.zeilenHoehe)

      Furche().padding(.vertical, Abstand.s)

      // Eigenes Hintergrundbild im Spektrum – geht auch ohne Radio
      Text("HINTERGRUNDBILD").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
        .frame(height: Mass.zeilenHoehe)
      HStack(spacing: Abstand.s) {
        Button("Laden …") { hintergrund.laden() }.buttonStyle(KnopfStil())
        Button("Entfernen") { hintergrund.entfernen() }.buttonStyle(KnopfStil())
          .disabled(hintergrund.bild == nil)
        Spacer()
        Text(hintergrund.bild == nil ? "keins" : "aktiv").font(Schrift.klein).foregroundStyle(Theme.textDim)
      }
      .frame(height: Mass.zeilenHoehe)
      regler("Abdunkeln", $hintergrund.abdunkeln)
        .disabled(hintergrund.bild == nil)
    }
    .font(Schrift.normal)
    .padding(Abstand.m)
    .frame(width: 320)
    .background(Theme.rimuBlock)
  }

  // MARK: Bausteine

  private func regler(_ titel: String, _ wert: Binding<Double>, bereich: ClosedRange<Double> = 0...100) -> some View {
    HStack(spacing: Abstand.s) {
      Text(titel).frame(width: 96, alignment: .leading)
      Slider(value: wert, in: bereich).controlSize(.small)
      Text("\(Int(wert.wrappedValue.rounded()))").font(Schrift.zahl).frame(width: 36, alignment: .trailing)
    }
    .frame(height: Mass.zeilenHoehe)
  }

  private func hex(_ id: UInt32) -> String { "0x" + String(id, radix: 16, uppercase: true) }

  private func panSetze(_ pan: Panadapter, _ k: String, _ v: String) { radio.sende("display pan set \(hex(pan.id)) \(k)=\(v)") }
  private func wfSetze(_ wf: Waterfall, _ k: String, _ v: String) { radio.sende("display panafall set \(hex(wf.id)) \(k)=\(v)") }

  private func panZahl(_ pan: Panadapter?, _ pfad: ReferenceWritableKeyPath<Panadapter, Int>, _ k: String) -> Binding<Double> {
    Binding(
      get: { Double(pan?[keyPath: pfad] ?? 0) },
      set: { neu in
        guard let pan else { return }
        let w = Int(neu.rounded())
        guard w != pan[keyPath: pfad] else { return }
        pan[keyPath: pfad] = w
        panSetze(pan, k, String(w))
      })
  }

  private func panSchalter(_ pan: Panadapter?, _ pfad: ReferenceWritableKeyPath<Panadapter, Bool>, _ k: String) -> Binding<Bool> {
    Binding(
      get: { pan?[keyPath: pfad] ?? false },
      set: { neu in
        guard let pan else { return }
        pan[keyPath: pfad] = neu
        panSetze(pan, k, neu ? "1" : "0")
      })
  }

  private func wfZahl(_ wf: Waterfall?, _ pfad: ReferenceWritableKeyPath<Waterfall, Int>, _ k: String) -> Binding<Double> {
    Binding(
      get: { Double(wf?[keyPath: pfad] ?? 0) },
      set: { neu in
        guard let wf else { return }
        let w = Int(neu.rounded())
        guard w != wf[keyPath: pfad] else { return }
        wf[keyPath: pfad] = w
        wfSetze(wf, k, String(w))
      })
  }

  private func wfSchalter(_ wf: Waterfall?, _ pfad: ReferenceWritableKeyPath<Waterfall, Bool>, _ k: String) -> Binding<Bool> {
    Binding(
      get: { wf?[keyPath: pfad] ?? false },
      set: { neu in
        guard let wf else { return }
        wf[keyPath: pfad] = neu
        wfSetze(wf, k, neu ? "1" : "0")
      })
  }

  /// dB-Bereich des Spektrums (Radio: min_dbm / max_dbm)
  private func dbm(_ pan: Panadapter?, unten: Bool) -> Binding<Double> {
    Binding(
      get: { Double(unten ? (pan?.minDbm ?? -135) : (pan?.maxDbm ?? -40)) },
      set: { neu in
        guard let pan else { return }
        let w = neu.rounded()
        if unten {
          guard w < Double(pan.maxDbm) - 10 else { return }
          pan.minDbm = CGFloat(w)
          panSetze(pan, "min_dbm", String(format: "%.1f", w))
        } else {
          guard w > Double(pan.minDbm) + 10 else { return }
          pan.maxDbm = CGFloat(w)
          panSetze(pan, "max_dbm", String(format: "%.1f", w))
        }
      })
  }
}

// MARK: - DAX IQ (IQ-Daten des Panadapters an andere Programme)

struct DaxIqPopup: View {
  var fertig: () -> Void
  private let radio = RadioVerbindung.shared

  var body: some View {
    let s = radio.meinSlice
    let pan = s.flatMap { sl in radio.api.panadapters.first { $0.id == sl.panadapterId } }
    VStack(alignment: .leading, spacing: Abstand.xs) {
      Text("DAXIQ KANAL").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
      ForEach(0...4, id: \.self) { k in
        Button(k == 0 ? "Off" : "Kanal \(k)") {
          if let pan {
            pan.daxIqChannel = k
            radio.sende("display pan set 0x\(String(pan.id, radix: 16, uppercase: true)) daxiq_channel=\(k)")
          }
          fertig()
        }
        .buttonStyle(KnopfStil(art: (pan?.daxIqChannel ?? 0) == k ? .an : .aus, breite: 110))
        .disabled(pan == nil)
      }
    }
    .padding(Abstand.m)
    .background(Theme.rimuBlock)
  }
}
