// MARK: - Antennen-Wahl (wie SmartSDR: Antenne, RF-Gain, WNB des Panadapters – ohne Loop A/B)

struct AntennenPopup: View {
  private let radio = RadioVerbindung.shared
  @State private var tx = "ANT1"

  var body: some View {
    let s = radio.meinSlice
    let pan = s.flatMap { sl in radio.api.panadapters.first { $0.id == sl.panadapterId } }
    VStack(alignment: .leading, spacing: Abstand.s) {
      Text("ANTENNE").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)

      // RX-Antenne des Panadapters als Knopfreihe
      zeile("RX") {
        knopfReihe(pan?.antList.nilWennLeer ?? s?.rxAntList.nilWennLeer ?? ["ANT1", "ANT2", "RX_A", "RX_B"],
                   aktiv: pan?.rxAnt ?? s?.rxAnt ?? "") { ant in
          if let pan { pan.rxAnt = ant; panSetze(pan, "rxant", ant) }
        }
      }
      // TX-Antenne des Slice
      zeile("TX") {
        knopfReihe(s?.txAntList.nilWennLeer ?? ["ANT1", "ANT2"], aktiv: s?.txAnt ?? tx, rot: true) { ant in
          if let s { s.txAnt = ant; radio.setze(s, "txant", ant) } else { tx = ant }
        }
      }

      Furche()

      // Loop A/B bewusst weggelassen: Einschleifwege für externe Geräte, vom Nutzer nicht genutzt
      // (Radio hat das Einschalten in seiner Konfiguration abgelehnt)

      // RF-Gain in den Stufen des Radios (8600M: −8 … 32 dB in 8er-Schritten)
      zeile("RF Gain") {
        let stufen = rfStufen(pan)
        knopfReihe(stufen.map { "\($0) dB" }, aktiv: "\(pan?.rfGain ?? 0) dB") { text in
          guard let pan, let wert = Int(text.replacingOccurrences(of: " dB", with: "")) else { return }
          pan.rfGain = wert
          panSetze(pan, "rfgain", String(wert))
        }
      }

      // WNB des Panadapters
      HStack(spacing: Abstand.s) {
        Text("WNB").frame(width: 56, alignment: .leading)
        RimuSlider(value: Binding(
          get: { Double(pan?.wnbLevel ?? 50) },
          set: { neu in
            guard let pan else { return }
            let w = Int(neu.rounded())
            guard w != pan.wnbLevel else { return }
            pan.wnbLevel = w
            panSetze(pan, "wnb_level", String(w))
          }))
        Text("\(pan?.wnbLevel ?? 50)").font(Schrift.zahl).frame(width: 28, alignment: .trailing)
        Toggle("", isOn: panSchalter(pan, \.wnbEnabled, "wnb")).toggleStyle(.checkbox).labelsHidden()
      }
      .disabled(pan == nil)
    }
    .font(Schrift.normal)
    .padding(Abstand.m)
    .frame(width: 440)
    .background(Theme.rimuBlock)
  }

  private func zeile<Inhalt: View>(_ titel: String, @ViewBuilder _ inhalt: () -> Inhalt) -> some View {
    HStack(spacing: Abstand.s) {
      Text(titel).frame(width: 56, alignment: .leading)
      inhalt()
      Spacer(minLength: 0)
    }
    .frame(height: Mass.zeilenHoehe)
  }

  private func knopfReihe(_ werte: [String], aktiv: String, rot: Bool = false,
                          _ wahl: @escaping (String) -> Void) -> some View {
    HStack(spacing: Abstand.xs) {
      ForEach(werte, id: \.self) { w in
        Button(w) { wahl(w) }
          .buttonStyle(KnopfStil(art: w == aktiv ? (rot ? .rot : .an) : .aus))
      }
    }
  }

  private func rfStufen(_ pan: Panadapter?) -> [Int] {
    guard let pan, pan.rfGainStep > 0, pan.rfGainHigh > pan.rfGainLow else { return [-8, 0, 8, 16, 24, 32] }
    return Array(stride(from: pan.rfGainLow, through: pan.rfGainHigh, by: pan.rfGainStep))
  }

  private func panSetze(_ pan: Panadapter, _ schluessel: String, _ wert: String) {
    radio.sende("display pan set 0x\(String(pan.id, radix: 16, uppercase: true)) \(schluessel)=\(wert)")
  }

  private func panSchalter(_ pan: Panadapter?, _ pfad: ReferenceWritableKeyPath<Panadapter, Bool>,
                           _ schluessel: String) -> Binding<Bool> {
    Binding(
      get: { pan?[keyPath: pfad] ?? false },
      set: { neu in
        guard let pan else { return }
        pan[keyPath: pfad] = neu
        panSetze(pan, schluessel, neu ? "1" : "0")
      })
  }
}

// MARK: - Breite des Panadapters (BW)

struct BreitePopup: View {
  var fertig: () -> Void
  private let radio = RadioVerbindung.shared

  /// (Beschriftung, Breite in Hz) – 0 = Min, -1 = Max, -2 = Band, -3 = Segment
  private let knoepfe: [(String, Int)] = [
    ("Min", 0), ("1 kHz", 1_000), ("2.5 kHz", 2_500),
    ("5 kHz", 5_000), ("10 kHz", 10_000), ("20 kHz", 20_000),
    ("25 kHz", 25_000), ("50 kHz", 50_000), ("75 kHz", 75_000),
    ("100 kHz", 100_000), ("200 kHz", 200_000), ("300 kHz", 300_000),
    ("500 kHz", 500_000), ("1 MHz", 1_000_000), ("5 MHz", 5_000_000),
    ("Max", -1), ("Band", -2), ("Segment", -3),
  ]

  var body: some View {
    let s = radio.meinSlice
    let pan = s.flatMap { sl in radio.api.panadapters.first { $0.id == sl.panadapterId } }
    VStack(alignment: .leading, spacing: Abstand.s) {
      Text("BREITE").font(Schrift.kleinFett).foregroundStyle(Theme.textDim)
      LazyVGrid(columns: Array(repeating: GridItem(.fixed(78), spacing: Abstand.xs), count: 3), spacing: Abstand.xs) {
        ForEach(knoepfe, id: \.0) { titel, hz in
          Button(titel) {
            if let pan { waehle(pan, hz) }
            fertig()
          }
          .buttonStyle(KnopfStil(art: pan.map { istAktiv($0, hz) } ?? false ? .an : .aus, breite: 78))
          .disabled(pan == nil)
        }
      }
    }
    .padding(Abstand.m)
    .background(Theme.rimuBlock)
  }

  private func istAktiv(_ pan: Panadapter, _ hz: Int) -> Bool {
    switch hz {
    case -2: return pan.bandZoomEnabled
    case -3: return pan.segmentZoomEnabled
    case 0: return pan.minBw > 0 && pan.bandwidth == pan.minBw
    case -1: return pan.maxBw > 0 && pan.bandwidth == pan.maxBw
    default: return abs(pan.bandwidth - hz) < max(1, hz / 50)
    }
  }

  private func waehle(_ pan: Panadapter, _ hz: Int) {
    let id = "0x" + String(pan.id, radix: 16, uppercase: true)
    switch hz {
    case -2: radio.sende("display pan set \(id) band_zoom=1")
    case -3: radio.sende("display pan set \(id) segment_zoom=1")
    case 0: radio.panBreite(pan, Double(pan.minBw > 0 ? pan.minBw : 1_000), sofort: true)
    case -1: radio.panBreite(pan, Double(pan.maxBw > 0 ? pan.maxBw : 14_000_000), sofort: true)
    default: radio.panBreite(pan, Double(hz), sofort: true)
    }
  }
}

