import ApiPackage
import SwiftUI

/// Knopfleiste links im Panadapter (RimuSDR-Stil), senkrecht über die ganze Höhe.
/// ◀ fährt sie ein, unten öffnet „Audio“ die Audiokette links.
struct PanadapterToolbar: View {
  @Binding var audioOpen: Bool  // linkes Panel (Audiokette) offen?
  @State private var open = true  // Knopfleiste ausgefahren?
  @State private var active: Set<String> = []  // welcher Knopf gerade sein Popup offen hat

  /// Knöpfe von oben nach unten
  private let buttons = ["+RX", "+Split", "+TNF", "Band", "BW", "ANT", "Disp", "DAXIQ", "Mem"]

  var body: some View {
    Group {
      if open {
        VStack(spacing: 6) {
          // Einfahren
          iconButton("chevron.left", help: "Knopfleiste einfahren") { open = false }

          ForEach(buttons, id: \.self) { title in
            FlatButton(title: title, isOn: title == "+Split" ? splitAn : active.contains(title)) {
              if title == "+Split" { splitUmschalten() } else { toggle(title) }
            }
              .popover(isPresented: popupOffen(title), arrowEdge: .trailing) {
                popup(title)
              }
          }

          Spacer(minLength: 0)

          // Audiokette ein-/ausfahren
          FlatButton(title: "Audio", isOn: audioOpen) { audioOpen.toggle() }
        }
        .padding(6)
        .frame(width: 66)
        .frame(maxHeight: .infinity)
        .background(Theme.panel.opacity(0.92))
        .overlay(alignment: .trailing) {
          Rectangle().fill(Theme.border).frame(width: 1)
        }
        .transition(.move(edge: .leading))
      } else {
        // Eingefahren: nur ein schmaler Griff mit ▶
        VStack {
          iconButton("chevron.right", help: "Knopfleiste ausfahren") { open = true }
          Spacer(minLength: 0)
        }
        .padding(.vertical, 6)
        .frame(width: 22)
        .frame(maxHeight: .infinity)
        .background(Theme.panel.opacity(0.92))
        .transition(.move(edge: .leading))
      }
    }
    .font(Schrift.normal)
    .animation(.easeInOut(duration: 0.2), value: open)
  }

  /// Kleiner Knopf nur mit Symbol
  private func iconButton(_ symbol: String, help: String, action: @escaping () -> Void) -> some View {
    Button(action: action) {
      Image(systemName: symbol)
        .font(Schrift.kleinFett)
        .foregroundStyle(Theme.textDim)
        .frame(maxWidth: .infinity)
        .frame(height: 22)
        .contentShape(Rectangle())
    }
    .buttonStyle(.plain)
    .focusEffectDisabled()
    .help(help)
  }

  // MARK: - Popups der Knöpfe (Band, ANT – weitere folgen)

  private static let mitPopup: Set<String> = ["Band", "ANT", "BW", "Mem", "Disp", "DAXIQ"]

  /// Popup ist offen, solange der Knopf an ist; Schließen schaltet den Knopf wieder aus
  private func popupOffen(_ title: String) -> Binding<Bool> {
    Binding(
      get: { Self.mitPopup.contains(title) && active.contains(title) },
      set: { if !$0 { active.remove(title) } })
  }

  @ViewBuilder private func popup(_ title: String) -> some View {
    switch title {
    case "Band": BandPopup { active.remove("Band") }
    case "ANT": AntennenPopup()
    case "BW": BreitePopup { active.remove("BW") }
    case "Mem": SpeicherPopup { active.remove("Mem") }
    case "Disp": DisplayPopup()
    case "DAXIQ": DaxIqPopup { active.remove("DAXIQ") }
    default: EmptyView()
    }
  }

  // MARK: - Split (A empfängt, B sendet 5 kHz höher)

  private var radio: RadioVerbindung { RadioVerbindung.shared }

  /// Split ist an, wenn es zwei Slices gibt und der letzte (B) TX hat
  private var splitAn: Bool {
    let slices = radio.eigeneSlices
    return slices.count > 1 && (slices.last?.txEnabled ?? false)
  }

  /// Aus: neuen Slice B 5 kHz über A anlegen und TX darauf legen (A bleibt RX).
  /// An: TX zurück auf A. Ist B schon da, wird er nur zum Sende-Slice.
  private func splitUmschalten() {
    guard radio.istVerbunden else { return }
    let slices = radio.eigeneSlices
    guard let a = slices.first else { return }

    if slices.count > 1, let b = slices.last {
      let ziel = splitAn ? a : b
      ziel.txEnabled = true
      radio.setze(ziel, "tx", true)
      return
    }

    let hz = Double(a.frequency + 5_000) / 1_000_000
    radio.sende("slice create pan=0x\(String(a.panadapterId, radix: 16, uppercase: true)) freq=\(String(format: "%.6f", hz)) mode=\(a.mode)")
    // Auf den neuen Slice warten (bis ca. 3 s) und TX darauf legen
    Task { @MainActor in
      for _ in 0..<20 {
        try? await Task.sleep(for: .milliseconds(150))
        let jetzt = radio.eigeneSlices
        if jetzt.count > 1, let b = jetzt.last {
          b.txEnabled = true
          radio.setze(b, "tx", true)
          return
        }
      }
    }
  }

  private func toggle(_ title: String) {
    if active.contains(title) { active.remove(title) } else { active.insert(title) }
  }
}

